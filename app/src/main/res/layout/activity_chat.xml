<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1226">

    <!-- Верхняя панель чата со старым ID chats_appbar -->
    <LinearLayout
        android:id="@+id/chats_appbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/chat_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/chat_image"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/default_profile_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Имя"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ChatConnectionTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="в сети"
                android:textColor="#8B78FF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Список сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/chatBottomBar"
        android:layout_below="@id/chats_appbar"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Нижняя панель ввода -->
    <LinearLayout
        android:id="@+id/chatBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/c_send_image_BTN"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_file_upload"
            android:tint="#8E97B0" />

        <EditText
            android:id="@+id/c_input_message"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_glass_card"
            android:hint="Сообщение..."
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E97B0"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/c_send_message_BTN"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_gradient_pill"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:tint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
